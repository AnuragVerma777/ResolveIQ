# ==============================================================================
# ResolveIQ Production Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# NEVER commit .env containing live secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. Security, CORS & Network Policies
# ------------------------------------------------------------------------------
# Comma-separated list of origins allowed to access the API via browser CORS.
# For production, specify your exact domain (e.g. https://resolveiq.yourdomain.com).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000

# Maximum incoming HTTP request body size in Megabytes (guards against payload bomb DoS)
MAX_REQUEST_BODY_SIZE_MB=20

# Enable in-memory token-bucket rate limiter for sensitive endpoints (upload, submit)
RATE_LIMIT_ENABLED=true

# Optional: Require Bearer API key authentication for all backend requests.
# If left empty, API operates in open internal mode (or behind API gateway/ingress).
MERCHANT_API_KEY=

# ------------------------------------------------------------------------------
# 3. Database Persistence & Document Storage
# ------------------------------------------------------------------------------
# Path to SQLite database file. Ensure the parent directory is persistent in Docker volumes.
DB_PATH=storage/resolveiq.db

# Standard 12-factor database URL. (e.g. sqlite:///storage/resolveiq.db)
DATABASE_URL=sqlite:///storage/resolveiq.db

# Directory where uploaded merchant evidence files (PDF, DOCX, images) are stored.
UPLOAD_DIR=storage/uploads

# Maximum file size allowed for individual uploaded documents (in Megabytes)
MAX_UPLOAD_SIZE_MB=15

# ------------------------------------------------------------------------------
# 4. PayPal REST API Integration
# ------------------------------------------------------------------------------
# Sandbox URL: https://api-m.sandbox.paypal.com
# Live Production URL: https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# 5. Google Gemini AI Engine
# ------------------------------------------------------------------------------
# API Key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 6. Zapier Webhooks Integration
# ------------------------------------------------------------------------------
# Catch Hook URL from your Zapier Zap (e.g. https://hooks.zapier.com/hooks/catch/xxxx/yyyy)
ZAPIER_WEBHOOK_URL=
ZAPIER_WEBHOOK_TIMEOUT_SECONDS=8.0

# ------------------------------------------------------------------------------
# 7. Frontend Client Settings (Vite)
# ------------------------------------------------------------------------------
# Base path for backend API. Default /api works for unified single-origin deployments.
# If deploying frontend to a separate CDN or domain, set to https://api.yourdomain.com/api
VITE_API_BASE=/api
